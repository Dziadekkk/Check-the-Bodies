@17 = ~Niech sprawdzę... Tak, <GABBER>, poszukiwacz przygód przybywający z Wrót Baldura. Pochodzący z Candlekeep. Zgadza się? Tak. Świetnie. Z moich dokumentów wynika, że jako poszukiwacz przygód jesteście winni Amn sporą część swojego majątku. Moje dane mówią o dwudziestu procentach, co daje w sumie 6000 sztuk złota. Panie, wasz dług wobec Amn wynosi 6000 sztuk złota.~ ~Niech sprawdzę... Tak, <GABBER>, poszukiwaczka przygód przybywająca z Wrót Baldura. Pochodząca z Candlekeep. Zgadza się? Tak. Świetnie. Z moich dokumentów wynika, że jako poszukiwaczka przygód jesteście winni Amn sporą część swojego majątku. Moje dane mówią o dwudziestu procentach, co daje w sumie 6000 sztuk złota. Pani, wasz dług wobec Amn wynosi 6000 sztuk złota.~
@18 = ~Sześć tysięcy sztuk złota? To oburzające. Nie zapłacę.~
@19 = ~Bardzo dobrze, panie. Życzę udanego pobytu w Athkatli.~ ~Bardzo dobrze, pani. Życzę udanego pobytu w Athkatli.~
@20 = ~Co masz na myśli mówiąc, że nie zapłacisz? Takie jest prawo, panie. Musisz rozliczyć się ze mną, albo stawić czoła konsekwencjom odmowy.~ ~Co masz na myśli mówiąc, że nie zapłacisz? Takie jest prawo, pani. Musisz rozliczyć się ze mną, albo stawić czoła konsekwencjom odmowy.~
@21 = ~Nie zamierzam niczego płacić Amn. Wyjeżdżam.~
@22 = ~Nie zapłacę ci nawet jednej sztuki srebra. To ostateczna odpowiedź.~
@23 = ~Jeśli Amn życzy sobie mojego złota, będzie zmuszone wydrzeć je ode mnie siłą.~
@24 = ~Jak sobie życzysz, panie. Dobrego dnia.~ ~Jak sobie życzysz, pani. Dobrego dnia.~
@25 = ~Możecie wyjechać, możecie zapłacić, możemy też umieścić was w areszcie. Decyduj, panie.~ ~Możecie wyjechać, możecie zapłacić, możemy też umieścić was w areszcie. Decyduj, pani.~
@26 = ~Skoro takie jest twoje życzenie, to przymusimy cię, panie.~ ~Skoro takie jest twoje życzenie, to przymusimy cię, pani.~