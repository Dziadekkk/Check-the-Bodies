@1   = ~Manny! Mój chłopcze! <CHARNAME>! Musisz znaleźć sposób, by go wskrzesić!~
@2   = ~Nie teraz. Jesteśmy trochę zajęci, ale zrobię to najszybciej, jak się da.~
@3   = ~Dobrze. Daj mi chwilkę.~
@4   = ~I tak był bezużyteczny. Faerun jest lepszym miejscem bez niego.~
@5   = ~Mistrzu! Mistrzu Arkaneusie! Szybko, <CHARNAME>! Musisz go wskrzesić.~
@6   = ~Oczywiście.~
@7   = ~Zrobię to najszybciej, jak się da.~
@8   = ~<CHARNAME>! Marilyn właśnie umarła! Możesz coś zrobić, by ją przywrócić do żywych?~
@9   = ~Spróbuję. Po prostu poczekaj.~
@10  = ~Oczywiście, już ją wskrzeszam. Daj mi minutę.~
@11  = ~A niech cię, Tardecie, dlaczego to zrobiłeś? <CHARNAME>! Tardeth potrzebuje pomocy!~
@12  = ~Sądzę, że nie można mu już pomóc.~
@13  = ~Widziałem. Zajmę się tym, gdy tylko skończę tutaj.~ ~Widziałam. Zajmę się tym, gdy tylko skończę tutaj.~
@14  = ~Głupi elf! Zginie za nas! <CHARNAME>! Sylvanus potrzebuje czarów kapłańskich! Możesz mu pomóc?~
@15  = ~Oczywiście, już go wskrzeszam. Daj mi minutę.~
@16  = ~Paddy! Nieeeee!~
@17  = ~Nie martw się, wskrzesimy go za chwilę. Wracaj do swych zadań!~
@18  = ~Póki co zadbaj o własne bezpieczeństwo! Paddym zajmiemy się później!~
@19  = ~Lawantha! <CHARNAME>! Musimy zabrać ją do kapłana!~
@20  = ~Zajmę się tym.~
@21  = ~Nie sądzę, bym był w stanie zanieść ją tak daleko.~ ~Nie sądzę, bym była w stanie zanieść ją tak daleko.~
@22  = ~Przyprowadzę tu kapłana, by jej pomógł.~
@23  = ~Zrób to. <CHARNAME>, dzięki.~
@24  = ~Jak możesz mówić takie rzeczy? Mam nadzieję, że to przemyślisz.~
@25  = ~<CHARNAME>! Musisz coś zrobić!~