@1  = ~Jestem zaskoczona, że ten zramolały Gorion pozwolił ci zostawić naukę i robotę. Co za kupa bzdur. Też się wymknęłam. Stary Brzuchacz Winthrop mnie szukał, ale mam cały dzień na swoją robotę.~
@2  = ~Obawiam się, że nie mogę dzisiaj rozmawiać, malutka. Mój przybrany ojciec życzy sobie, abym wypełnił wszystkie obowiązki, dzięki czemu będzie mógł odbyć ze mną lekcję dzisiejszego wieczoru.~ ~Obawiam się, że nie mogę dzisiaj rozmawiać, malutka. Mój przybrany ojciec życzy sobie, abym wypełniła wszystkie obowiązki, dzięki czemu będzie mógł odbyć ze mną lekcję dzisiejszego wieczoru.~
@3  = ~Mam obowiązki do wykonania. Też nie powinnaś się ociągać. Winthrop zechce, żebyś poskładała łóżka, gdy tylko wyrobisz się ze stajnią.~
@4  = ~Zostaw mnie! Nie mam dzisiaj czasu do stracenia na ciebie, dzieciaku!~
@5  = ~Malutka? Oboje jesteśmy dosyć młodzi, chociaż ty faktycznie urosłeś szybko. Względnie szybko, powiedzmy.~ ~Malutka? Obie jesteśmy dosyć młode, chociaż ty faktycznie urosłaś szybko. Względnie szybko, powiedzmy.~
@6  = ~Dzieciaku? Popatrz lepiej, kto jest wystarczająco duży, aby pić u Brzuchacza. <CHARNAME>, pamiętaj, że jesteś tylko kilka miesięcy starszy niż ja. No, zmykaj, leć do swoich małych zadanek.~ ~Dzieciaku? Popatrz lepiej, kto jest wystarczająco duży, aby pić u Brzuchacza. <CHARNAME>, pamiętaj, że jesteś tylko kilka miesięcy starsza niż ja. No, zmykaj, leć do swoich małych zadanek.~
@7  = ~Lepiej się zmywam, skoro masz dużo roboty dla pana G.~
@8  = ~To było zdecydowanie niemiłe, wasza wyniosłość. Dobra, zostanę tutaj i zajmę się swoim. Jesteśmy przyjaciółmi, więc mówisz odczep się i ja tak robię. Chwytam aluzje równie szybko jak portfele. Lepiej już idź... nie chcesz chyba, żeby pan G. musiał czekać, no i może zobaczymy się później...~ ~To było zdecydowanie niemiłe, wasza wyniosłość. Dobra, zostanę tutaj i zajmę się swoim. Jesteśmy przyjaciółkami, więc mówisz odczep się i ja tak robię. Chwytam aluzje równie szybko jak portfele. Lepiej już idź... nie chcesz chyba, żeby pan G. musiał czekać, no i może zobaczymy się później...~
@9  = ~Nie każ panu G. dłużej czekać. Dalej, ruszaj do pracy!~
@10 = ~Zrobiłaś już swoje rzeczy? Wiesz, że stary Brzuchacz nie pozwoli ci się bawić, zanim nie skończysz.~
@11 = ~Powiedziałem Gorionowi, że nie zamierzam dłużej wykonywać jego poleceń. Dostałem lanie.~ ~Powiedziałam Gorionowi, że nie zamierzam dłużej wykonywać jego poleceń. Dostałam lanie.~
@12 = ~Taa. Wszystko zrobione. Zagramy?~
@13 = ~Nie, Imoen, jeszcze nie skończyłem.~ ~Nie, Imoen, jeszcze nie skończyłam.~
@14 = ~<CHARNAME>, nie powinieneś denerwować Goriona. A skoro masz kłopoty, nie wiem, czy powinieneś się ze mną bawić. Może pobawimy się kiedy indziej.~ ~<CHARNAME>, nie powinnaś denerwować Goriona. A skoro masz kłopoty, nie wiem, czy powinnaś się ze mną bawić. Może pobawimy się kiedy indziej.~
@15 = ~<CHARNAME>, w samą porę. Postaraj się wyrobić jutro szybciej, to będziemy mieć więcej czasu na zabawę. No dalej.~
@16 = ~Mam cię! BEREK!~
@17 = ~Teraz pobawmy się w chowanego! Szukasz! Licz do stu!~
@18 = ~Znalazłeś mnie! Już późno. Idź lepiej poszukać Goriona w sprawie tej twojej lekcji. Pobawimy się jeszcze później.~ ~Znalazłaś mnie! Już późno. Idź lepiej poszukać Goriona w sprawie tej twojej lekcji. Pobawimy się jeszcze później.~
@19 = ~Już skończyłem, Imoen. Chcesz się bawić?~ ~Już skończyłam, Imoen. Chcesz się bawić?~