@550255 = ~Widocznie zbyt dĹ‚ugo zwlekaliĹ›cie z przeniesieniem rodziny wampirĂłw. Zostali zniszczeni przez Ĺ›wiatĹ‚o sĹ‚oneczne.~
@550256 = ~Blok lodu, ktĂłry taszczyliĹ›cie ze sobÄ…, stopiĹ‚ siÄ™. ByÄ‡ moĹĽe naleĹĽaĹ‚o dostarczyÄ‡ go szybciej.~
@550257 = ~Klinga Ĺšpiewnych CzarĂłw nie wybraĹ‚a ciebie na swego prawowitego wĹ‚aĹ›ciciela. W odruchu buntu, ostrze wybucha.~
@550258 = ~KsiÄ™ĹĽycowe ostrze nie wybraĹ‚o ciebie na swego prawowitego wĹ‚aĹ›ciciela. W odruchu buntu, ostrze wybucha.~
@550259 = ~Elfi spijacz sokĂłw nie wybraĹ‚ ciebie na swego prawowitego wĹ‚aĹ›ciciela. Ostrze buntuje siÄ™ przeciwko tobie, a ty masz obowiÄ…zek przestaÄ‡ go uĹĽywaÄ‡, tak szybko, jak to moĹĽliwe.~
@550260 = ~To ostrze wybraĹ‚o ciebie jako swego dzielnego i honorowego posiadacza, jedna z uĹ›pionych mocy KsiÄ™ĹĽycowego ostrza zostaĹ‚a uwolniona.~
@550261 = ~Czasy siÄ™ zmieniajÄ…, a my nie zmieniamy siÄ™ z nimi.~ [CB_77725]
@550262 = ~ZrobiÄ™ wszystko, aby zapewniÄ‡ ci bezpieczeĹ„stwo.~ [CB_77726]
@550263 = ~Niech Corellan Lotharian obdarzy Ĺ‚askÄ… nasze Ĺ›cieĹĽki.~ [CB_77727]
@550264 = ~UwaĹĽaj, gdzie mnÄ… celujesz.~ [CB_77728]
@550265 = ~Seldarine osÄ…dzÄ… nas za wszystkie nasze czyny.~ [CB_77729]
@550266 = ~JesteĹ›my gotowi na nasze zadanie. Idziemy naprzĂłd w imieniu Ludu.~ [CB_77730]
@550267 = ~Zawsze myĹ›laĹ‚em o tobie jak o kimĹ› wyjÄ…tkowym.~ [CB_77731]
@550268 = ~Nie ucz matki chowaÄ‡ dziatki.~ [CB_77732]
@550269 = ~To zaszczyt byÄ‡ twoim towarzyszem.~ [CB_77733]
@550270 = ~Nie lekce sobie waĹĽÄ™ moich obowiÄ…zkĂłw.~ [CB_77734]
@550271 = ~WskaĹĽ drogÄ™, a wykonamy dzieĹ‚o Seldarine, tu w Faerunie.~ [CB_77735]
@550272 = ~Trwaj w gotowoĹ›ci, a staniemy na wysokoĹ›ci zadania.~ [CB_77736]
@550273 = ~Bez czci dla Seldarine, nie moĹĽemy mieÄ‡ nadziei na heroiczne czyny.~ [CB_77737]
@550274 = ~Ĺšpiewaj hymny o Lesie i Splocie, a nic zĹ‚ego siÄ™ nie stanie.~ [CB_77738]
@550275 = ~JesteĹ› najzacniejszÄ… osobÄ… spoĹ›rĂłd moich dotychczasowych posiadaczy.~ [CB_77739]
@550276 = ~Czas sprowadziÄ‡ go na ziemiÄ™.~ [CB_77740]
@550277 = ~Nawet nie wiesz, jak blisko jesteĹ› tego, by poczuÄ‡ moje ostrze.~ [CB_77741]
@550278 = ~Spoczywaj spokojnie, Ĺ›mierÄ‡ juĹĽ przychodzi po ciebie.~ [CB_77742]
@550279 = ~Kolejny spieszÄ…cy na cmentarz.~ [CB_77743]
@550280 = ~Niech Seldarine majÄ… dla ciebie litoĹ›Ä‡.~ [CB_77744]
@550281 = ~Niech twoja ostatnia wÄ™drĂłwka bÄ™dzie spokojna.~ [CB_77745]
@550282 = ~Posmakuj mego ostrza!~ [CB_77746]
@550283 = ~Za Lud!~ [CB_77747]
@550284 = ~To nie dziĹ› polegniemy.~ [CB_77748]
