//Cutscena: Hull naucza Piruetu ofensywnego
@550103 = ~CĂłĹĽ, dzieciaku, kiedy walczysz w starciu i chcesz powaĹĽnie zraniÄ‡ swego przeciwnika w krĂłtkim czasie, wielu wojownikĂłw siÄ™ga po technikÄ™ powszechnie zwanÄ… ofensywnym piruetem.~
@550104 = ~Jest to stan podobny do transu, w ktĂłrym atakujÄ…cy porusza siÄ™ szybciej, podnosi swoje umiejÄ™tnoĹ›ci trafiania, uderza niemal z prÄ™dkoĹ›ciÄ… bĹ‚yskawicy, celniej i zadajÄ…c maksymalne moĹĽliwe dana broniÄ… obraĹĽenia.~
@550105 = ~W ogniu walk ta technika, czy teĹĽ trans bÄ™dzie trwaĹ‚ tylko kilka chwil, jednak moĹĽe okazaÄ‡ siÄ™ zabĂłjczy dla sĹ‚abszych przeciwnikĂłw czy szykujÄ…cych siÄ™ do rzucania czarĂłw magĂłw.~
@550106 = ~Aby sprawdziÄ‡ tÄ™ technikÄ™, dam ci miecz; masz go uĹĽyÄ‡ przeciwko mnie, zaatakowaÄ‡. Nie bÄ™dÄ™ z tobÄ… walczyĹ‚, ale chcÄ™ byĹ› koncentrowaĹ‚<PRO_HESHE> siÄ™ na tym, gdzie jestem, jak porusza siÄ™ twĂłj miecz, jak musisz siÄ™ ustawiÄ‡ do ciÄ™cia czy pchniÄ™cia i, co najwaĹĽniejsze, musisz zaplanowaÄ‡ nastÄ™pne uderzenie na dĹ‚ugo przedtem, nim wykonasz atak.~
@550107 = ~Oto podstawa ofensywnego piruetu, dzieciaku, planuj gdzie uderzaÄ‡ zanim w ogĂłle zaczniesz atakowaÄ‡. CĂłĹĽ, sprĂłbujmy jeszcze raz.~

//Cutscena: Hull naucza Tropienia
@550108 = ~Aby znaleĹşÄ‡ swoich wrogĂłw, dzieciaku, musisz poznaÄ‡ otoczenie.~
@550109 = ~Na przykĹ‚ad, nie znajdziesz yeti w ciemnej jaskini w Podmroku. Chyba ĹĽe towarzyszyÄ‡ ci bÄ™dzie Zgromadzenie Mystry, wiesz?~
@550110 = ~Tak samo, nie znajdziesz mumii w lesie.~
@550111 = ~To najwaĹĽniejsza zasada tropienia - musisz wiedzieÄ‡, czego szukaÄ‡. ZademonstrowaĹ‚bym ci to lepiej, gdybyĹ›my byli w lesie, a nie w koszarach, ale uĹĽyj wyobraĹşni.~
@550112 = ~WyobraĹş sobie, ĹĽe widzisz na ziemi dwie pary odciskĂłw stĂłp. ZastanĂłw siÄ™, jakich wskazĂłwek mogÄ… ci one dostarczyÄ‡.~
