@0 = ~Ojcze, proszę, bez przemów. Mam nieodparte wrażenie, że moje życie wystarczająco się skomplikuje. Czy możemy odpuścić sobie te wszystkie wykłady czy prace i przejść od razu do konkluzji?~
@1 = ~Jak śmiesz, moje dziecko! Wykłady i prace kształtują charakter, dzięki czemu w przyszłości będzie doskonalszy... Ach, do diabła z nimi!~
@2 = ~*fiu*~
@3 = ~Wolisz się dowiedzieć, jak rzucać rozproszenie magii czy ochronę przed złem?~
@4 = ~Rozproszenie magii.~
@5 = ~Ochronę przed złem.~
@6 = ~Wolisz umiejętność wytrzymałości czy tropienia?~
@7 = ~Wytrzymałości~
@8 = ~Tropienia~
@9 = ~Wolisz umiejętność alchemii czy pisania zwojów?~
@10 = ~Alchemii~
@11 = ~Pisania zwojów~
@12 = ~Wolisz umiejętność piruetu ofensywnego czy może defensywnego?~
@13 = ~Defensywnego~
@14 = ~Ofensywnego~
@15 = ~Chciał<PRO_HESHE>byś otrzymać znak Lathandera?~
@16 = ~Tak.~
@17 = ~Nie.~
@18 = ~Załatwione. Czas więc uznać twoje dzieciństwo za zakończone.~