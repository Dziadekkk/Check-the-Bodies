@1   = ~"<RACE>? Tutaj? Nawet mnie trudno w to uwierzyć."~ 
@2   = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> wędrowny poszukiwacz przygód z obnażoną bronią, budzi mnie z mojej drzemki."~ ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> wędrowna poszukiwaczka przygód z obnażoną bronią, budzi mnie z mojej drzemki."~
@3   = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> dwójka wędrownych poszukiwaczy przygód z obnażoną bronią, budzi mnie z mojej drzemki."~ 
@4   = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> trójka nieokrzesanych poszukiwaczy przygód z obnażoną bronią, budzi mnie z mojej drzemki."~
@5   = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> czwórka uzbrojonych po zęby poszukiwaczy przygód z obnażoną bronią, budzi mnie z mojej drzemki."~ 
@6   = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> piątka weteranów bitew z obnażoną bronią, budzi mnie z mojej drzemki."~
@7   = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> szóstka kompanów od magii i miecza z obnażoną bronią, budzi mnie z mojej drzemki."~
@8   = ~"Możeś przybył tu pomścić swoich pobratymców, których pożarłam? Ich truchła gniją tuż przy wejściu."~ ~"Możeś przybyła tu pomścić swoich pobratymców, których pożarłam? Ich truchła gniją tuż przy wejściu."~ 
@9   = ~"To nie ma znaczenia. Zarżnę was wszystkich niczym niemowlęta w kołyskach."~
@10  = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> wędrowny poszukiwacz przygód, niewystarczająco inteligentny, by uniknąć mojej uwagi, budzi mnie z mojej drzemki."~ ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> wędrowna poszukiwaczka przygód, niewystarczająco inteligentna, by uniknąć mojej uwagi, budzi mnie z mojej drzemki."~ 
@11  = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> dwójka poszukiwaczy przygód, niewystarczająco inteligentnych, by uniknąć mojej uwagi, budzi mnie z mojej drzemki."~
@12  = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> trójka nieokrzesanych poszukiwaczy przygód, niewystarczająco inteligentnych, by uniknąć mojej uwagi, budzi mnie z mojej drzemki."~
@13  = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> czwórka uzbrojonych po zęby poszukiwaczy przygód, niewystarczająco inteligentnych, by uniknąć mojej uwagi, budzi mnie z mojej drzemki."~ 
@14  = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> piątka weteranów bitew, niewystarczająco inteligentnych, by uniknąć mojej uwagi, budzi mnie z mojej drzemki."~
@15  = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> szóstka kompanów od magii i miecza, niewystarczająco inteligentnych, by uniknąć mojej uwagi, budzi mnie z mojej drzemki."~ 
@16  = ~"Możeś przybył tu, skryty w cieniu i z zakamuflowanym zapachem, myśląc o zagrabieniu złota, artefaktów i wszelkiego bogactwa, jakiem zgromadziła przez eony?"~ ~"Możeś przybyła tu, skryta w cieniu i z zakamuflowanym zapachem, myśląc o zagrabieniu złota, artefaktów i wszelkiego bogactwa, jakiem zgromadziła przez eony?"~
@17  = ~"Gdybym miała wyrazić swoje zdanie na ten temat, to stałbyś się moim kolejnym posiłkiem, jak ci, którzy leżą tuż przy wejściu."~ ~"Gdybym miała wyrazić swoje zdanie na ten temat, to stałabyś się moim kolejnym posiłkiem, jak ci, którzy leżą tuż przy wejściu."~
@18  = ~"W opowieściach bardów czarodzieje siedzą sobie beztrosko, aż wedrze się do nich bohater, ale w prawdziwym życiu smoki nie są tak lekkomyślne."~
@19  = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> wędrowny poszukiwacz przygód, z plecakiem wypełnionym po brzegi skradzionym bogactwem, budzi mnie z mojej drzemki."~ ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> wędrowna poszukiwaczka przygód, z plecakiem wypełnionym po brzegi skradzionym bogactwem, budzi mnie z mojej drzemki."~ 
@20  = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> dwójka poszukiwaczy przygód, z plecakami wypełnionymi po brzegi skradzionym bogactwem, budzi mnie z mojej drzemki."~
@21  = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> trójka nieokrzesanych poszukiwaczy przygód, z plecakami wypełnionymi po brzegi skradzionym bogactwem, budzi mnie z mojej drzemki."~ 
@22  = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> czwórka uzbrojonych po zęby poszukiwaczy przygód, z plecakami wypełnionymi po brzegi skradzionym bogactwem, budzi mnie z mojej drzemki."~ 
@23  = ~"I oto urzeczywistnia się legenda.. W dniu <DAYANDMONTH> piątka weteranów bitew, z plecakami wypełnionymi po brzegi skradzionym bogactwem, budzi mnie z mojej drzemki."~
@24  = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> szóstka kompanów od magii i miecza, z plecakami wypełnionymi po brzegi skradzionym bogactwem, budzi mnie z mojej drzemki."~ 
@25  = ~"Możeś zjawił się tutaj z nadzieją, że mnie zaskoczysz, myśląc, że ukradniesz skarby, jakiem zgromadziła od czasu, kiedyś ty był jedynie błyskiem w oku swojej babki, gdy spoglądała na twego dziadka."~ ~"Możeś zjawiła się tutaj z nadzieją, że mnie zaskoczysz, myśląc, że ukradniesz skarby, jakiem zgromadziła od czasu, kiedyś ty była jedynie błyskiem w oku swojej babki, gdy spoglądała na twego dziadka."~
@26  = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> wędrowny poszukiwacz przygód budzi mnie z mojej drzemki."~ ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> wędrowna poszukiwaczka przygód budzi mnie z mojej drzemki."~
@27  = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> dwójka wędrownych poszukiwaczy przygód budzi mnie z mojej drzemki."~
@28  = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> trójka nieokrzesanych poszukiwaczy przygód budzi mnie z mojej drzemki."~
@29  = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> czwórka uzbrojonych po zęby poszukiwaczy przygód, budzi mnie z mojej drzemki."~
@30  = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> piątka weteranów bitew, budzi mnie z mojej drzemki."~
@31  = ~"I oto urzeczywistnia się legenda. W dniu <DAYANDMONTH> szóstka kompanów od magii i miecza, budzi mnie z mojej drzemki."~
@32  = ~"Możeś zjawił się tutaj myśląc, że zabijesz mnie i ukradniesz skarby, jakiem zgromadziła od czasu, kiedyś ty był jedynie błyskiem w oku swojej babki, gdy spoglądała na twego dziadka."~ ~"Możeś zjawiła się tutaj myśląc, że zabijesz mnie i ukradniesz skarby, jakiem zgromadziła od czasu, kiedyś ty była jedynie błyskiem w oku swojej babki, gdy spoglądała na twego dziadka."~
@33  = ~"Królowie oraz królowe mogą przesiadywać ze swymi doradcami, dopóki wojna nie zawita na ich ziemie, ale w prawdziwym życiu smoki nie są tak lekkomyślne."~
@34  = ~"Wierzę jednak, naprawdę wierzę, że to nie tego pragniesz. Odłóż swój oręż, poszukiwaczu przygód, i mów."~ ~"Wierzę jednak, naprawdę wierzę, że to nie tego pragniesz. Odłóż swój oręż, poszukiwaczko przygód, i mów."~
@35  = ~W mojej mocy leży, nikczemna jaszczuro, aby zabić się tam, gdzie stoisz. Jednakże daruję ci życie, bo mój honor nakazuje dać ci szansę.~
@36  = ~Nie, potężna smoczyco, mylisz się. Skradłbym wszystkie twoje skarby i zabiłbym cię tam, gdzie stoisz.~ ~Nie, potężna smoczyco, mylisz się. Skradłabym wszystkie twoje skarby i zabiłabym cię tam, gdzie stoisz.~
@37  = ~Jestem teraz twoim panem, smoczyco, i podlegasz mojej woli w sposób tak niepodważalny i zupełny, w jaki kontroluję swoje własne ręce!~ ~Jestem teraz twoją panią, smoczyco, i podlegasz mojej woli w sposób tak niepodważalny i zupełny, w jaki kontroluję swoje własne ręce!~
@38  = ~"Bogowie na wysokościach, czy te piekielne bitwy nigdy nie ustaną?"~
@39  = ~"To będzie niczym zarzynanie dzieci w kołyskach."~
@40  = ~"Poluję na tych ziemiach od stuleci, głupcze, w krainie gór starszych ode mnie, otoczonej przez najtwardsze ze skał, w kłębowisku ogromnych, prastarych urwisk, gdzie rzadko widuje się drzewa, jak gdyby lasy Cormanthyru nie miały chęci wspinać się na te wyżyny."~ ~"Poluję na tych ziemiach od stuleci, głupia dziewczyno, w krainie gór starszych ode mnie, otoczonej przez najtwardsze ze skał, w kłębowisku ogromnych, prastarych urwisk, gdzie rzadko widuje się drzewa, jak gdyby lasy Cormanthyru nie miały chęci wspinać się na te wyżyny."~
@41  = ~"Sądzę, że uzyskanie umiejętności wystarczających, aby mnie pokonać, zajęłoby ci setki lat."~
@42  = ~"Jednakże zaoferuję ci szansę zagrania ze mną w grę, w której wy, poszukiwacze przygód, odnajdujecie przyjemność przy okazji spotkania ze smokiem."~
@43  = ~"Proponuję ci, poszukiwaczu przygód, szansę na zdobycie tego, do czego wojownicy i magowie dążą od zarania dziejów: władztwa nad smokami."~ ~"Proponuję ci, poszukiwaczko przygód, szansę na zdobycie tego, do czego wojownicy i magowie dążą od zarania dziejów: władztwa nad smokami."~
@44  = ~"Przestrzegam cię, poszukiwaczu przygód, że obowiązywać będą pewne zasady, których należy się trzymać - zasady postępowania, do których ty i ja będziemy się nieprzerwanie stosować."~ ~"Przestrzegam cię, poszukiwaczko przygód, że obowiązywać będą pewne zasady, których należy się trzymać - zasady postępowania, do których ty i ja będziemy się nieprzerwanie stosować."~
@45  = ~Słucham cię, smoczyco. Powiedz mi, co proponujesz.~
@46  = ~Nie zamierzam wchodzić z tobą w żadne układy, smoczyco. Zabiję cię tam, gdzie stoisz.~
@47  = ~Nie rozumiem, potężna smoczyco. Czego ode mnie oczekujesz? Że będę czekał, aż mnie pożresz?~ ~Nie rozumiem, potężna smoczyco. Czego ode mnie oczekujesz? Że będę czekała, aż mnie pożresz?~
@48  = ~"Po pierwsze, poszukiwaczu przygód, musimy się nawzajem szanować. Szacunek nie zaistnieje, zanim się sobie nie przedstawimy. Wiedz zatem, że chcę poznać twoje imię."~ ~"Po pierwsze, poszukiwaczko przygód, musimy się nawzajem szanować. Szacunek nie zaistnieje, zanim się sobie nie przedstawimy. Wiedz zatem, że chcę poznać twoje imię."~
@49  = ~Jestem tym, który był, który jest i który będzie. Jestem, który jestem.~ ~Jestem tą, która była, która jest i która będzie. Jestem, która jestem.~
@50  = ~Nie ufam ci, jaszczuro. Sądzę, że próbujesz mnie zwieść. Połóżmy temu kres!~
@51  = ~Jestem <GABBER>, <MANWOMAN>a bez domu. Ja również chciał<HESHE>bym poznać twoje imię.~
@52  = ~Różnie na mnie mówią, ale ty, potężny smoku, możesz mnie nazywać Solaufein.~
@53  = ~Możesz po prostu mówić na mnie Elminster.~
@54  = ~"Natykam się na poszukiwaczy przygód od czasu, kiedyś ty był jedynie błyskiem w oku swojej babki, gdy spoglądała na twego dziadka. Wiem, że mnie okłamujesz i znieważasz w ten sposób własny honor."~ ~"Natykam się na poszukiwaczy przygód od czasu, kiedyś ty była jedynie błyskiem w oku swojej babki, gdy spoglądała na twego dziadka. Wiem, że mnie okłamujesz i znieważasz w ten sposób własny honor."~
@55  = ~"Nie dojdzie między nami do Honorowego Pojedynku, a ty staniesz się moim śniadaniem."~
@56  = ~"Uważasz się za boga? Nie, głupcze, nie zwiedziesz mnie takimi przechwałkami. Nie zdążyłeś jeszcze zyskać mojego podziwu, a już znieważyłeś szacunek istniejący między nami."~ ~"Uważasz się za boginię? Nie, głupia dziewczyno, nie zwiedziesz mnie takimi przechwałkami. Nie zdążyłaś jeszcze zyskać mojego podziwu, a już znieważyłaś szacunek istniejący między nami."~
@57  = ~"Całkiem miło cię poznać, mój przyszły posiłku. Znana jestem pod imieniem Darammarethy S'oolouny Crommadary Ammanthy Kuleery, zaś w twoim języku jako Aksamitnostopa."~
@58  = ~"Być może zatem, <CHARNAME>, mimo iż niechętnie, to jednak szanujemy się nawzajem wystarczająco, by uszanować kodeks Honorowego Pojedynku. Czy znane ci są prastare zasady rządzące tym szlachetnym starciem smoka z człowiekiem?"~
@59  = ~Znam zasady, smoczyco. Zaczynajmy.~
@60  = ~Nie, Darammaretho S'oolouno Crommadaro Ammantho Kuleero. Nie znam zasad związanych z tą tradycją.~
@61  = ~Darammaretho S'oolouno Crommadaro Ammantho Kuleero, wiedz, że pewnego razu zabiłem potężnego czerwonego smoka, który dał mi szansę na taki pojedynek. Sądził, że może mnie oszukać, ale ja byłem świadom wszystkich obowiązujących reguł tej tradycji. Będzie lepiej dla ciebie, jeśli sama będziesz na nie zważała, inaczej zabiję cię za naruszenie układu.~ ~Darammaretho S'oolouno Crommadaro Ammantho Kuleero, wiedz, że pewnego razu zabiłam potężnego czerwonego smoka, który dał mi szansę na taki pojedynek. Sądził, że może mnie oszukać, ale ja byłem świadom wszystkich obowiązujących reguł tej tradycji. Będzie lepiej dla ciebie, jeśli sama będziesz na nie zważała, inaczej zabiję cię za naruszenie układu.~
@62  = ~Przestań już kłapać dziobem i po prostu powiedz, co to za reguły.~
@63  = ~"Dobrze, <GABBER>. Musimy jednak dokładnie określić zasady pojedynku, zanim zaczniemy, co zresztą - jak utrzymujesz - jest ci wiadome."~
@64  = ~"W czasie Honorowego Pojedynku nie ma miejsca na tego rodzaju przechwałki, <GABBER>. Hańbisz moje zobowiązanie, a jeszcze nawet nie zaczęliśmy."~
@65  = ~"<GABBER>, Honorowy Pojedynek jest instytucją starszą niż ty i ja, i nie można zmieniać jego reguł. Są to dość proste zasady, łatwe do zrozumienia nawet dla tak prymitywnej kreatury jak ty."~
@66  = ~"Pierwszy związany z pojedynkiem warunek, jaki musimy sobie wyjaśnić, określa ilość bólu i ran, jaką każdy z uczestników może otrzymać."~
@67  = ~"Ta ilość jest możliwa do ustalenia przed rozpoczęciem pojedynku."~
@68  = ~"Kolejne postanowienie kodeksu Honorowego Pojedynku określa ograniczenia w używaniu magicznych zdolności takich jak: zaklęcia, broń czy umiejętności."~
@69  = ~"Trzecie postanowienie Honorowego Pojedynku pozwala uczestnikom wybrać rodzaje broni, jakiej wolno im używać."~
@70  = ~"I wreszcie, <GABBER>, zasady Honorowego Pojedynku wymagają, aby w przypadku przegranej druga strona zyskała coś wartościowego."~
@71  = ~"Teraz, <GABBER>, musimy podjąć decyzje dotyczące tych zasad. Zawrzyjmy zatem ugodę."~
@72  = ~"Co do pierwszej zasady proponuję, abyśmy zgodzili się na walkę aż do pozostania jedynie ćwierci sił witalnych. Co ty na to?"~ ~"Co do pierwszej zasady proponuję, abyśmy zgodziły się na walkę aż do pozostania jedynie ćwierci sił witalnych. Co ty na to?"~
@73  = ~Ćwierć jest dla mnie do przyjęcia. Kontynuuj, smoczyco.~
@74  = ~Może powinniśmy poprzestać na połowie. Byłoby to mniej bolesne dla nas obojga.~ ~Może powinnyśmy poprzestać na połowie. Byłoby to mniej bolesne dla nas obu.~
@75  = ~Nie, smoczyco. Aż do utraty przytomności.~
@76  = ~Moim zdaniem byłoby lepiej, gdybyśmy walczyli do pierwszej krwi. Przyjmijmy taką zasadę, smoczyco.~ ~Moim zdaniem byłoby lepiej, gdybyśmy walczyły do pierwszej krwi. Przyjmijmy taką zasadę, smoczyco.~
@77  = ~"Postanowione, <GABBER>. Oby twój wybór okazał się dla ciebie korzystny."~
@78  = ~"Teraz ustalmy ograniczenia dotyczące magicznych zdolności takich jak: zaklęcia, broń czy umiejętności, <GABBER>."~
@79  = ~"Sądzę, że najkorzystniej dla nas byłoby zabronić użycia jakiejkolwiek magii: zarówno objawionej, jak i mistycznej. Zgadzasz się?"~
@80  = ~To do przyjęcia, smoczyco. Kontynuuj.~
@81  = ~Specjalizuję się w rzucaniu czarów i nie zrezygnuję z tej umiejętności. Wszelkiego rodzaju zaklęcia z poziomów niższych, do piątego włącznie, niech będą dozwolone, pozostałe zaś nie.~
@82  = ~Chcę używać wszystkich zaklęć, smoczyco. Bez żadnych ograniczeń.~
@83  = ~"Zatem uzgodnione, <GABBER>. Żadnych zaklęć."~
@84  = ~"Zatem uzgodnione, <GABBER>. Zaklęcia niższe, do poziomu piątego włącznie, będą dozwolone."~
@85  = ~"Zatem uzgodnione, <GABBER>. Wolno będzie używać wszystkich czarów."~
@86  = ~"Czy wprowadzimy ograniczenia dotyczące wyboru broni? Domagam się prawa do używania szponów, ale nie kłów, skrzydeł czy ogona."~
@87  = ~Masz do tego prawo, smoczyco. Ja wybieram bronie obuchowe oraz kolne.~
@88  = ~Jak sobie życzysz. Ja z kolei wybieram bronie sieczne oraz kolne.~
@89  = ~Jeśli o mnie chodzi, to będę używać wyłącznie broni siecznych i obuchowych.~
@90  = ~"Mam prawo wstrzymać się z własną ofertą, dopóki przeciwnik czegoś nie zaproponuje. Czego zażądasz w razie wygranej, <GABBER>?"~
@91  = ~Chcę twoich skarbów. Wszystkich.~
@92  = ~Jeśli zwyciężę, chcę, abyś nauczyła mnie magicznych zaklęć, które znasz.~
@93  = ~Jest tylko jedna rzecz, której będę chcieć od ciebie, jeżeli wygram. Trochę twoich łusek.~
@94  = ~Jest tylko jedna rzecz, jakiej chcę od ciebie, potężna Darammaretho S'oolouno Crommadaro Ammantho Kuleero. Jeśli wygram, chcę, abyś udzieliła mi pomocy, kiedy będę jej potrzebować.~
@95  = ~"Wybieram zatem tę samą nagrodę, <GABBER>. Jeśli pokonam cię w Honorowym Pojedynku, twój majątek i bogactwa staną się moimi, a ty nie będziesz próbować ukraść ich z powrotem i powstrzymasz się od ponownej agresji wobec mnie."~
@96  = ~"Zgoda, <GABBER>. Jednakże moje żądanie może mi przynieść więcej korzyści. Jeśli pokonam cię w Honorowym Pojedynku, twój majątek i bogactwa staną się moimi, a ty nie będziesz próbować ukraść ich z powrotem i powstrzymasz się od ponownej agresji wobec mnie."~
@97  = ~"Moje łuski, <GABBER>? Niezwykła to prośba, ale zgadzam się na nią i sama uczynię podobne żądanie. Jeżeli wygram, będę chciała kawałka twojej skóry."~
@98  = ~"Zgoda, <GABBER>, ale z jednym zastrzeżeniem. Możesz wezwać mnie na pomoc tylko trzy razy. Nie więcej. Ja zaś nie będę wysuwała żadnych roszczeń odnośnie tego, jak mam ci pomagać. Zgoda?"~
@99  = ~Dobrze. A czego ty chcesz?~
@100 = ~Nie, zmieniłem zdanie. Chcę czegoś innego.~ ~Nie, zmieniłam zdanie. Chcę czegoś innego.~
@101 = ~"Jak sobie życzysz, <GABBER>. Czego się domagasz?"~
@102 = ~"Jeszcze nie wiem, <GABBER>. Niech no pomyślę."~
@103 = ~"Już wiem. Jeśli pokonam cię w Honorowym Pojedynku, twój majątek i bogactwa staną się moimi, a ty nie będziesz próbować ukraść ich z powrotem i powstrzymasz się od ponownej agresji wobec mnie."~
@104 = ~"Wybieram to: w razie mojej wygranej z tobą w Honorowym Pojedynku będę się domagała kawałka twojej skóry."~
@105 = ~"No dobrze. Ustaliliśmy warunki i możemy wkrótce zacząć pojedynek."~ ~"No dobrze. Ustaliłyśmy warunki i możemy wkrótce zacząć pojedynek."~
@106 = ~"Przypominam ci o zasadach, <GABBER>. Postaraj się ich nie splamić, inaczej możesz skończyć jako rozdęta ropucha albo stary babsztyl z obwisłym biustem."~
@107 = ~"Po pierwsze, nie rzucaj żadnych zaklęć."~
@108 = ~"Po pierwsze, nie rzucaj żadnych zaklęć wyższych niż piątego poziomu."~
@109 = ~"Po pierwsze, rzucanie wszelkich czarów jest dozwolone."~
@110 = ~"Będziemy walczyć tylko do momentu, w którym jedno z nas straci więcej niż trzy ćwierci sił witalnych. Ani mniej, ani więcej. Nie myśl nawet, by mnie oszukać, bo pojedynek się zakończy."~ ~"Będziemy walczyć tylko do momentu, w którym jedna z nas straci więcej niż trzy ćwierci sił witalnych. Ani mniej, ani więcej. Nie myśl nawet, by mnie oszukać, bo pojedynek się zakończy."~
@111 = ~"Będziemy walczyć tylko do momentu, w którym jedno z nas straci więcej niż połowę sił witalnych. Ani mniej, ani więcej. Nie myśl nawet, by mnie oszukać, bo pojedynek się zakończy."~  ~"Będziemy walczyć tylko do momentu, w którym jedna z nas straci więcej niż połowę sił witalnych. Ani mniej, ani więcej. Nie myśl nawet, by mnie oszukać, bo pojedynek się zakończy."~
@112 = ~"Będziemy walczyć tylko do momentu, w którym jedno z nas straci przytomność. Ani mniej, ani więcej. Nie myśl nawet, by mnie oszukać, bo pojedynek się zakończy."~ ~"Będziemy walczyć tylko do momentu, w którym jedna z nas straci przytomność. Ani mniej, ani więcej. Nie myśl nawet, by mnie oszukać, bo pojedynek się zakończy."~
@113 = ~"Będziemy walczyć tylko do momentu, w którym jedno z nas odniesie rany. Zgodnie z twoją propozycją - do pierwszej krwi. Nie myśl nawet, by mnie oszukać, bo pojedynek się zakończy."~ ~"Będziemy walczyć tylko do momentu, w którym jedna z nas odniesie rany. Zgodnie z twoją propozycją - do pierwszej krwi. Nie myśl nawet, by mnie oszukać, bo pojedynek się zakończy."~
@114 = ~"Na koniec przyjmujemy zasadę, że ja będę używała jako broni wyłącznie moich szponów. Ty również jesteś ograniczony do broni, którą wybrałeś."~ ~"Na koniec przyjmujemy zasadę, że ja będę używała jako broni wyłącznie moich szponów. Ty również jesteś ograniczona do broni, którą wybrałaś."~
@115 = ~"Wolno ci używać wyłącznie broni obuchowych i kolnych. Nie używaj broni innego typu, bo tym sposobem złamiesz zasady."~
@116 = ~"Wolno ci używać wyłącznie broni siecznych i kolnych. Nie używaj broni innego typu, bo tym sposobem złamiesz zasady."~
@117 = ~"Wolno ci używać wyłącznie broni obuchowych i siecznych. Nie używaj broni innego typu, bo tym sposobem złamiesz zasady."~
@118 = ~"<GABBER>, bandaże, które nosisz, są brudne i sztywne od zakrzepłej krwi. Może lepiej będzie, jeśli odpoczniesz i się wyleczysz, zanim staniesz do Honorowego Pojedynku."~
@119 = ~"Dotrzymam naszej ugody i nie zaatakuję cię, kiedy będziesz się leczyć."~
@120 = ~"Sądzę, że możemy zacząć pojedynek, <GABBER>.  W imię swojego honoru trzymaj się zasad i warunków, jakie ustaliliśmy."~ ~"Sądzę, że możemy zacząć pojedynek, <GABBER>.  W imię swojego honoru trzymaj się zasad i warunków, jakie ustaliłyśmy."~
@121 = ~"Gotowy, by zacząć, <GABBER>?"~ ~"Gotowa, by zacząć, <GABBER>?"~
@122 = ~Tak, szlachetna Darammaretho S'oolouno Crommadaro Ammantho Kuleero. Zaczynajmy.~
@123 = ~Jeszcze nie, Darammaretho S'oolouno Crommadaro Ammantho Kuleero.~
@124 = ~"Dobrze, <GABBER>. W imię swojego honoru trzymaj się zasad i warunków, jakie zostały przez nas ustalone."~
@125 = ~"W takim razie powiedz mi, kiedy będziesz gotowy."~ ~"W takim razie powiedz mi, kiedy będziesz gotowa."~
@126 = ~"W twojej przegranej nie ma wstydu, poszukiwaczu przygód. Walczyłeś dzielnie i honorowo."~ ~"W twojej przegranej nie ma wstydu, poszukiwaczko przygód. Walczyłaś dzielnie i honorowo."~
@127 = ~"Zaprawdę, nieczęsto się zdarzało w ciągu kilku minionych stuleci, aby zjawił się tu <RACE> walczący zgodnie z zasadami."~
@128 = ~"Twoje umiejętności rzeczywiście zrobiły na mnie wrażenie, jednakże w wyniku swojej honorowej porażki masz dług do zapłaty."~
@129 = ~"Obiecałeś mi swój dobytek i swoje skarby, zanim rozpoczęliśmy Honorowy Pojedynek. Czy zamierzasz dotrzymać tej wiążącej ugody, <CHARNAME>?"~ ~"Obiecałaś mi swój dobytek i swoje skarby, zanim rozpoczęłyśmy Honorowy Pojedynek. Czy zamierzasz dotrzymać tej wiążącej ugody, <CHARNAME>?"~
@130 = ~Oczywiście, potężna Darammaretho S'oolouno Crommadaro Ammantho Kuleero. Proszę, oddaję ci mój dobytek i zostawię cię w spokoju.~
@131 = ~Nie, potężna Darammaretho S'oolouno Crommadaro Ammantho Kuleero. Nie mogę oddać ci moich rzeczy. Uczynię wszystko co konieczne, by je zatrzymać.~
@132 = ~"Po raz kolejny okazujesz mi szacunek. Złóż, proszę, przede mną swoje rzeczy i złoto, a potem odejdź, <CHARNAME>. Jestem zmęczona i muszę teraz odpocząć.~
@133 = ~"Hańbisz i mnie, i siebie! W żaden sposób mnie nie oszukasz, mnie: Darammarethę S'oolounę Crommadarę Ammanthę Kuleerę! Zabójczynię istot potężniejszych, niż pojawiają się w twoich marzeniach! Giń, <CHARNAME>!"~
@134 = ~"Zawarliśmy zobowiązanie, <CHARNAME>, z którego, jak sądzę, nie będziesz chciał się wywiązać. Poprosiłeś mnie o moje łuski, a ja z kolei zażądałem twojej skóry. Wydaje się, że nie ma sposobu, abyś był w stanie dobrowolnie dać mi to, co mi się należy."~ ~"Zawarłyśmy zobowiązanie, <CHARNAME>, z którego, jak sądzę, nie będziesz chciała się wywiązać. Poprosiłaś mnie o moje łuski, a ja z kolei zażądałam twojej skóry. Wydaje się, że nie ma sposobu, abyś była w stanie dobrowolnie dać mi to, co mi się należy."~
@135 = ~"Masz dwie możliwości, <CHARNAME>. Dasz mi swoją skórę po dobroci albo zmusisz mnie, abym sama ją od ciebie wzięła. Jak będzie?"~
@136 = ~Zrobię to, skoro muszę, potężna Darammaretho S'oolouno Crommadaro Ammantho Kuleero. Oddzielę swoją skórę od ciała, ale, proszę cię, poczekaj.~
@137 = ~Potężna Darammaretho S'oolouno Crommadaro Ammantho Kuleero, nie mogę dać ci mojej skóry. Uczynię wszystko co konieczne, by ją zatrzymać.~
@138 = ~"Rozumiem twoją niechęć, <CHARNAME>. Nie jest to coś, co większość byłaby w stanie sama sobie uczynić. Ja jednakże muszę dostać to, co mi się należy."~
@139 = ~"Potrafię zrozumieć trudności, jakie możesz z tym mieć. Nie jest to coś, co większość byłaby w stanie sama sobie uczynić. <CHARNAME>, oszczędzę ci tej czynności. Zrobię to szybko za ciebie."~
@140 = ~"Odczuwam wielki wstyd będąc pokonaną przez istotę śmiertelną, nawet tak silną jak ty, <CHARNAME>. Walczyłeś dzielnie i honorowo."~ ~"Odczuwam wielki wstyd będąc pokonaną przez istotę śmiertelną, nawet tak silną jak ty, <CHARNAME>. Walczyłaś dzielnie i honorowo."~
@141 = ~"Twoje umiejętności rzeczywiście zrobiły na mnie wrażenie, a ja, w wyniku mojej honorowej porażki, mam do spłacenia dług."~
@142 = ~"Przyrzekłeś mi swoje skarby w zamian za obietnicę moich własnych i uczciwie pokonałeś mnie w Honorowym Pojedynku. Dotrzymam tego porozumienia, ale ostrzegam cię, <CHARNAME>."~ ~"Przyrzekłaś mi swoje skarby w zamian za obietnicę moich własnych i uczciwie pokonałaś mnie w Honorowym Pojedynku. Dotrzymam tego porozumienia, ale ostrzegam cię, <CHARNAME>."~
@143 = ~"Jeśli jeszcze kiedyś tu wrócisz, zginiesz. W mękach. A teraz zabieraj moje bogactwa, gromadzone przez lata dłuższe niż przyjdzie ci oglądać. Wynoś się z moich leży i nie wracaj."~
@144 = ~"Zgodnie z obowiązującymi zasadami przed naszym pojedynkiem obiecaliśmy sobie nawzajem coś wartościowego. Uczciwie mnie pokonałeś, a ja zastosuję się do twojej prośby o to, aby nauczyć cię moich magicznych zaklęć."~ ~"Zgodnie z obowiązującymi zasadami przed naszym pojedynkiem obiecałyśmy sobie nawzajem coś wartościowego. Uczciwie mnie pokonałaś, a ja zastosuję się do twojej prośby o to, aby nauczyć cię moich magicznych zaklęć."~
@145 = ~"Jednakże nie będzie moją winą, jeśli nie uda ci się w pełni pojąć tej magii. To nie było częścią umowy."~
@146 = ~"Proszę, <CHARNAME>, zwoje pergaminu z magicznymi zaklęciami... starsze niż ty i ja. Użyj ich mądrze."~
@147 = ~"Jeśli jeszcze kiedyś tu wrócisz, zginiesz. W mękach. Wynoś się z moich leży i nie wracaj."~
@148 = ~"Zgodnie z obowiązującymi zasadami przed naszym pojedynkiem obiecaliśmy sobie nawzajem coś wartościowego. Uczciwie mnie pokonałeś, a ja zastosuję się do twojej prośby o to, aby wynagrodzić cię kilkoma łuskami z mojego ciała."~ ~"Zgodnie z obowiązującymi zasadami przed naszym pojedynkiem obiecałyśmy sobie nawzajem coś wartościowego. Uczciwie mnie pokonałaś, a ja zastosuję się do twojej prośby o to, aby wynagrodzić cię kilkoma łuskami z mojego ciała."~
@149 = ~"Proszę, <CHARNAME>, wyrwałam je sobie z własnego boku, by były całe i niezniszczone."~
@150 = ~"Zgodnie z obowiązującymi zasadami przed naszym pojedynkiem obiecaliśmy sobie nawzajem coś wartościowego. Uczciwie mnie pokonałeś, a ja zastosuję się do twojego życzenia dotyczącego mojej osoby."~ ~"Zgodnie z obowiązującymi zasadami przed naszym pojedynkiem obiecałyśmy sobie nawzajem coś wartościowego. Uczciwie mnie pokonałaś, a ja zastosuję się do twojego życzenia dotyczącego mojej osoby."~
@151 = ~"Jednakże nie jest to coś, co staje się udziałem wielu. To, o co poprosiłeś, jest rzadkie i nieczęsto udzielane, nawet za sprawą Honorowego Pojedynku."~ ~"Jednakże nie jest to coś, co staje się udziałem wielu. To, o co poprosiłaś, jest rzadkie i nieczęsto udzielane, nawet za sprawą Honorowego Pojedynku."~
@152 = ~"Jesteś kimś wyjątkowym, <CHARNAME>, dlatego ci pomogę. Trzykrotnie. W sposób, jaki sam wybierzesz. Może nie tak, jak się spodziewałeś, ale przyjdę ci z pomocą."~ ~"Jesteś kimś wyjątkowym, <CHARNAME>, dlatego ci pomogę. Trzykrotnie. W sposób, jaki sama wybierzesz. Może nie tak, jak się spodziewałaś, ale przyjdę ci z pomocą."~
@153 = ~"Taką składam przysięgę, na mój honor i na mój ząb. Weź go, <CHARNAME>, i użyj, kiedy będziesz potrzebować pomocy. Zjawię się najszybciej, jak będę mogła."~
@154 = ~"Przypominam ci, <CHARNAME>, że nie będę zbyt szczęśliwa widząc cię ponownie w moich leżach, i że drogo zapłacisz za wciągnięcie mnie w te swoje knowania."~
@155 = ~"Jeśli jeszcze kiedyś wrócisz do tego leża, zginiesz. W mękach."~
@156 = ~"Jestem całkowicie pewna, że ostrzegałam cię, abyś mi więcej nie przeszkadzał. Masz już to, po co przyszedłeś. Odejdź stąd, <GABBER>, albo przekonasz się, że popełniłeś śmiertelną pomyłkę."~ ~"Jestem całkowicie pewna, że ostrzegałam cię, abyś mi więcej nie przeszkadzała. Masz już to, po co przyszłaś. Odejdź stąd, <GABBER>, albo przekonasz się, że popełniłaś śmiertelną pomyłkę."~
@157 = ~"Ostrzegałam cię, <GABBER>. Najwidoczniej nie sądziłeś, że ja, Darammaretha S'oolouna Crommadara Ammantha Kuleera, dotrzymam swojej obietnicy. Zapłacisz za ten błąd!"~ ~"Ostrzegałam cię, <GABBER>. Najwidoczniej nie sądziłaś, że ja, Darammaretha S'oolouna Crommadara Ammantha Kuleera, dotrzymam swojej obietnicy. Zapłacisz za ten błąd!"~