@1   = ~Centurionie! Znasz swoją powinność! Zabij tę hałastrę!~
@2   = ~Ty, zamknij się. Centurionie! Natychmiast każ swoim żołnierzom zabić tych wieśniaków!~
@3   = ~Centurionie! Twoja powinność! Zabij tych żałosnych prostaków bez żadnego wahania.~
@4   = ~Centurionie, ten żołnierz ma rację. Teraz, strażnicy, ZABIĆ TYCH WIEŚNIAKÓW!!!~
@5   = ~Głupi ludzie! Powinniście pomyśleć, zanim nas uwięziliście. Teraz za to zapłacicie. DO ATAKU!~
@6   = ~On oszalał! Centurionie, w tej chwili zabij tych wieśniaków!~ ~Ona oszalała! Centurionie, w tej chwili zabij tych wieśniaków!~
@7   = ~<CHARNAME>, dobry wybór. Potrafisz się zachować w trudnej sytuacji. A teraz odejdź, byśmy mogli posprzątać ten bałagan.~
@8   = ~Nie pokazuj się tu zbyt często. Nie będziesz mile widziany przez Zakapturzonych Czarodziejów.~ ~Nie pokazuj się tu zbyt często. Nie będziesz mile widziana przez Zakapturzonych Czarodziejów.~